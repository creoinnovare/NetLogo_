    </chooser>
    <slider x="20" step="1" y="175" max="50" width="240" display="restorative-capacity" height="50" min="0" direction="Horizontal" default="19.0" variable="restorative-capacity"></slider>
    <plot x="955" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="number of agents" y="570" xMin="0.0" height="235" legend="true" xMax="10.0" yMin="0.0" width="550" xAxis="simulation time (ticks)" display="Population State Over Time">
      <setup></setup>
