    <plot x="955" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="rate / disparity" y="305" xMin="0.0" height="220" legend="true" xMax="10.0" yMin="0.0" width="550" xAxis="ticks" display="Disparity Over Time">
