<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[extensions [decisions]

globals [
  
; Tracks what percentage of the population is 'rebelling'
  %active
  ; The overall 'mood' of the system
  tension-global
  jail-rate-marg
  jail-rate-base
  jail-disparity
  grievance-mean-marg
  grievance-mean-base
  grievance-disparity

  ; --- decisions extension demo (computed recommendations + smoke tests)
  policy-options
  policy-scored
  policy-ranked
  policy-best
  policy-best-id
  policy-best-score
  policy-best-breakdown
  demo-scored
  demo-ranked
  demo-best
]
breed [ citizens citizen ]
breed [ police officer ]
breed [ peacekeepers mediator ]

citizens-own [
  grievance        ; How upset the agent is (0-100)
  risk-aversion    ; How afraid they are of consequences (0-100)
  active?          ; Boolean: Is the agent currently acting out/violent?
  jail-term        ; If > 0, the agent is immobilized/removed
  equity-stake     ; How much do they feel responsible/involved (level of equity)
  marginalized?   ; true for high-grievance baseline group
]

patches-own [
  stress-level     ; Environmental variable: violence in a patch leaves a 'residue' of stress
]

to setup
  clear-all
  
  ; 1. Setup the Environment
  ask patches [
    set stress-level random 10
    set pcolor scale-color black stress-level 0 100
  ]

  ; 2. Create Citizens (The Population)
  create-citizens population-size [
    set shape "person"
    setxy random-xcor random-ycor
    set color white
    set active? false
    set jail-term 0
    
    ; EQUITY VARIABLE:
    ; Some agents start with higher grievance due to systemic inequality
    ; We distribute this unevenly to simulate marginalized groups
    ; MARGINALIZED VARIABLE:
    ifelse random 100 < baseline-inequity-rate [
      set marginalized? true
      set grievance 50 + random 50
    ] [
      set marginalized? false
      set grievance random 40
    ]
    update-appearance
    
    set risk-aversion random 100
  ]

  ; 3. Create Traditional Police (Punitive Force)
  create-police punitive-capacity [
    set shape "person"
    set color blue
    set size 1.5
    setxy random-xcor random-ycor
  ]

  ; 4. Create Peacekeepers (Restorative Force)
  create-peacekeepers restorative-capacity [
    set shape "person" ; Or a custom shape
    set color green
    set size 1.5
    setxy random-xcor random-ycor
  ]

  reset-ticks
end

to go
  ; 1. Citizen Behavior: Get mad, calm down, or rebel
  ask citizens [
      if jail-term > 0 [
        set jail-term jail-term - 1  ; Visual cue for "incarcerated"
        update-appearance            ; Skip the rest of the turn for this agent
        stop
      ]
    ; If free, behave normally
    move-randomly
    update-grievance
    check-rebellion
  ]

  ; 2. Police Behavior: Punitive Justice
  ; They look for ACTIVE rebels and arrest them
  ask police [
    move-randomly
    let suspect one-of citizens in-radius 3 with [active?]
    if suspect != nobody [
      ask suspect [
        set active? false
        set jail-term 50 + random 20 ; Long punishment
        set grievance grievance + 20 ; Punishment increases resentment (recidivism risk)
        if grievance > 100 [ 
          set grievance 100 
        ]
        move-to patch 0 0            ; Move to "prison" (center of map)
      ]
    ]
  ]

  ; 3. Peacekeeper Behavior: Restorative/Equity Justice
  ; They look for HIGH GRIEVANCE citizens (at risk) and heal them
  ask peacekeepers [
    move-randomly
    ; Find someone who is upset but NOT yet in jail
    let at-risk-person one-of citizens in-radius 3 with [grievance > 40 and jail-term = 0] 
    if at-risk-person != nobody [
      ask at-risk-person [
        set grievance grievance - 5  ; De-escalation
        if grievance < 0 [ set grievance 0 ]
        update-appearance
      ]
    ]
  ]
  
  ; Update global metrics
  update-metrics
  plot-disparity
  plot-grievance-disparity

  ; decisions extension overlay (policy recommendation)
  update-policy-decisions

  ; if ticks mod 50 = 0 [
  ;  export-decision-trace
  ; ]

  tick
end

; --- Helper Procedures ---

to move-randomly
  rt random 50 - 25
  fd 1
end

to update-grievance
  ; Natural fluctuation of mood
  set grievance grievance + (random 3 - 1)
  if grievance > 100 [ set grievance 100 ]
  if grievance < 0 [ set grievance 0 ]
end

to update-appearance
  if jail-term > 0 [ set color gray stop ]
  if active? [ set color red stop ]

  ifelse marginalized? [
    ifelse grievance > 50 [ set color orange ] [ set color yellow ]
  ] [
    ifelse grievance > 50 [ set color sky ] [ set color white ]
  ]
end

to check-rebellion
  ; If grievance exceeds risk aversion, the agent rebels
  set active? (grievance > risk-aversion)
  update-appearance
end

to update-metrics
  if not any? citizens [ stop ]

  let marg citizens with [marginalized?]
  let base citizens with [not marginalized?]

  ; guard against empty groups (edge case if slider = 0 or 100)
  let marg-n count marg
  let base-n count base

  ifelse marg-n > 0 [
    set jail-rate-marg (count marg with [jail-term > 0] / marg-n)
  ] [
    set jail-rate-marg 0
  ]

  ifelse base-n > 0 [
    set jail-rate-base (count base with [jail-term > 0] / base-n)
  ] [
    set jail-rate-base 0
  ]

  set jail-disparity (jail-rate-marg - jail-rate-base)

  ifelse marg-n > 0 [
    set grievance-mean-marg mean [grievance] of marg
  ] [
    set grievance-mean-marg 0
  ]

  ifelse base-n > 0 [
    set grievance-mean-base mean [grievance] of base
  ] [
    set grievance-mean-base 0
  ]

  set grievance-disparity (grievance-mean-marg - grievance-mean-base)
  
  set %active (100 * count citizens with [active?] / count citizens)
  set tension-global mean [grievance] of citizens
end

to plot-disparity
  set-current-plot "Disparity Over Time"

  set-current-plot-pen "jail-rate-marg"
  plot jail-rate-marg

  set-current-plot-pen "jail-rate-base"
  plot jail-rate-base

  set-current-plot-pen "jail-disparity"
  plot jail-disparity
end

to plot-grievance-disparity
  set-current-plot "Grievance Disparity Over Time"

  set-current-plot-pen "grievance-mean-marg"
  plot grievance-mean-marg

  set-current-plot-pen "grievance-mean-base"
  plot grievance-mean-base

  set-current-plot-pen "grievance-disparity"
  plot grievance-disparity
end

to-report clamp [x lo hi]
  report max (list lo (min (list hi x)))
end

to update-policy-decisions
  ; This is an "analytic overlay": the agent behavior is not changed.
  ; We simply build a few policy options, score them, and rank them.

  ; Define weights for our three core values
  ; let weights (list 0.4 0.3 0.3) ; [effectiveness fairness calm] [cite: 533]
  
  ; Base signals (all normalized to 0..100 where HIGH is "good")
  let effectiveness clamp (100 - %active) 0 100
  let fairness      clamp (100 - (abs jail-disparity) * 100) 0 100
  let calm          clamp (100 - tension-global) 0 100

  ; Heuristic "predicted" criteria for three policy styles.
  ; (These are intentionally simple, for demo/presentation clarity.)
  let punitive (list "punitive"
    (list
      (clamp (effectiveness + (punitive-capacity / 2)) 0 100)
      (clamp (fairness - (baseline-inequity-rate * 100)) 0 100)
      (clamp (calm - 8) 0 100)
    )
  )

  let restorative (list "restorative"
    (list
      (clamp (effectiveness - 5) 0 100)
      (clamp (fairness + (restorative-capacity / 2)) 0 100)
      (clamp (calm + 10) 0 100)
    )
  )

  let balanced (list "balanced"
    (list
      (clamp (effectiveness + (punitive-capacity / 4) - 2) 0 100)
      (clamp (fairness + (restorative-capacity / 4) - (baseline-inequity-rate * 50)) 0 100)
      (clamp (calm + 3) 0 100)
    )
  )
  
  let options (list punitive restorative balanced)
  ;set policy-options (list punitive restorative balanced)

  ; weights: [effectiveness fairness calm]
  let weights (list 0.4 0.3 0.3)

  ; Build [[id score breakdown] ...] which matches the "B" rank format you wanted.
let scored []
foreach options [ opt ->
  let id item 0 opt
  let criteria item 1 opt

  let sb decisions:score-with-breakdown criteria weights
  let score item 0 sb
  let breakdown item 1 sb

  set scored lput (list id score breakdown) scored
  ]

  set policy-scored scored
  ;set policy-ranked decisions:rank scored weights
  set policy-ranked decisions:rank options weights

  ifelse empty? policy-ranked [
    set policy-best nobody
    set policy-best-id ""
    set policy-best-score 0
    set policy-best-breakdown []
  ] [
    set policy-best first policy-ranked
    set policy-best-id item 0 policy-best
    set policy-best-score item 1 policy-best
    set policy-best-breakdown item 2 policy-best
  ]
end

to demo-decisions
  ; Minimal "hello world" for the decisions extension.
  ; Run this from the Command Center:
  ;   demo-decisions
  ;
  ; NOTE: In NetLogo, LISTS use (list ...), not [ ... ].
  ; Square brackets are for anonymous procedures.

  let options (list
    (list "A" (list 8 6 9))
    (list "B" (list 7 9 5))
  )

  let weights (list 0.4 0.3 0.3)

  let scored []
  foreach options [ opt ->
  let id item 0 opt
  let criteria item 1 opt

  let sb decisions:score-with-breakdown criteria weights
  set scored lput (list id (item 0 sb) (item 1 sb)) scored
  ]

  set demo-scored scored
  set demo-ranked decisions:rank scored weights
  set demo-best first demo-ranked

  show (word "scored = " demo-scored)
  show (word "ranked = " demo-ranked)
  show (word "best-id = " (item 0 demo-best) " score=" (item 1 demo-best))
  show (word "breakdown = " (item 2 demo-best))
end

to export-decision-trace-skip-best
  let filename (word "DecisionTrace_Tick_" ticks ".csv")
  if file-exists? filename [ file-delete filename ]
  file-open filename
  file-print "Timestamp,Punitive_Capacity,Restorative_Capacity,Inequity_Rate,Jail_Disparity,Grievance_Disparity,Best_Policy,Rationale"

  update-policy-decisions

  ;; build a real CSV line (file-write won’t add commas)
  let line (word date-and-time ","
                 punitive-capacity ","
                 restorative-capacity ","
                 baseline-inequity-rate ","
                 jail-disparity ","
                 grievance-disparity ","
                 policy-best-id ","
                 "\"" policy-best-breakdown "\"")
  file-print line

  file-close
  user-message (word "Decision Trace exported to: " filename)
end

to export-decision-trace
  ; 1. Define the filename with a timestamp or tick count
  let filename (word "DecisionTrace_Tick_" ticks ".csv")
  
  ; 2. Ensure the file is ready for writing
  if file-exists? filename [ file-delete filename ]
  file-open filename
  
  ; 3. Write Headers (Decision Context + Parameters + Metrics + Rationale)
  file-print "Timestamp,Punitive_Capacity,Restorative_Capacity,Inequity_Rate,Jail_Disparity,Grievance_Disparity,Best_Policy,Rationale"
  
  ; 4. Capture Extension Rationale
  ; We leverage decisions:explain-best from your extension primitives [cite: 360, 363]
  let explanation update-policy-decisions-and-report
  let best-id item 0 explanation
  let rationale item 2 explanation ; This contains the [criterion value weight contribution] breakdown [cite: 484]

  ; 5. Format and Write Data Row
  file-write date-and-time
  file-write punitive-capacity
  file-write restorative-capacity
  file-write baseline-inequity-rate
  file-write jail-disparity
  file-write grievance-disparity
  file-write best-id
  file-write rationale
  
  ; 6. Close the file and notify the user
  file-close
  user-message (word "Decision Trace exported to: " filename)
end

; Helper to return the explanation list for the export
to-report update-policy-decisions-and-report
  update-policy-decisions

  let criteria-list ["inequity" "jail_disparity" "grievance_disparity"]
  let score-method "weighted"
  let equity-mode "options"
  let weights-list (list 0.4 0.3 0.3)
  let top-n 1
  let equity-method "add"

  show (list "score" score-method "equity-mode" equity-mode "equity-method" equity-method)
  
  report decisions:explain-best policy-options criteria-list score-method equity-mode weights-list top-n equity-method
end]]></code>
  <widgets>
    <view x="285" wrappingAllowedX="true" y="195" frameRate="30.0" minPycor="-20" height="535" showTickCounter="true" patchSize="12.95122" fontSize="10" wrappingAllowedY="true" width="638" tickCounterLabel="ticks" maxPycor="20" updateMode="0" maxPxcor="24" minPxcor="-24"></view>
    <button x="295" y="95" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55" display="go">go</button>
