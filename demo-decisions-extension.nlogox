    </plot>
    <note x="390" y="70" backgroundDark="0" fontSize="12" width="365" markdown="false" height="40" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">High-Grievance Group represents agents starting with higher baseline grievance (inequity condition).</note>
    <monitor x="390" precision="2" y="115" height="60" fontSize="11" width="200" display="Currently jailed (High-Grievance)"><![CDATA[count citizens with [jail-term > 0 and marginalized?]]]></monitor>
    <monitor x="595" precision="2" y="115" height="60" fontSize="11" width="200" display="Currently jailed (Baseline)"><![CDATA[count citizens with [jail-term > 0 and not marginalized?]]]></monitor>
